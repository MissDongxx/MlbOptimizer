{
  "$defs": {
    "ActualCoverageSummary": {
      "additionalProperties": false,
      "properties": {
        "dnp_count": {
          "minimum": 0,
          "title": "Dnp Count",
          "type": "integer"
        },
        "extra_ids": {
          "items": {
            "type": "integer"
          },
          "title": "Extra Ids",
          "type": "array"
        },
        "feature_player_count": {
          "minimum": 1,
          "title": "Feature Player Count",
          "type": "integer"
        },
        "missing_ids": {
          "items": {
            "type": "integer"
          },
          "title": "Missing Ids",
          "type": "array"
        },
        "played_count": {
          "minimum": 0,
          "title": "Played Count",
          "type": "integer"
        },
        "records_count": {
          "minimum": 1,
          "title": "Records Count",
          "type": "integer"
        }
      },
      "required": [
        "feature_player_count",
        "records_count",
        "played_count",
        "dnp_count"
      ],
      "title": "ActualCoverageSummary",
      "type": "object"
    },
    "ActualPointsRecord": {
      "additionalProperties": false,
      "properties": {
        "actual_points": {
          "title": "Actual Points",
          "type": "number"
        },
        "mlbam_id": {
          "title": "Mlbam Id",
          "type": "integer"
        },
        "scoring_components": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Scoring Components",
          "type": "object"
        },
        "source_evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Evidence Id"
        },
        "source_game_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Game Id"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "played",
                "dnp_not_in_final_boxscore",
                "dnp_no_game_appearance"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        }
      },
      "required": [
        "mlbam_id",
        "actual_points"
      ],
      "title": "ActualPointsRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acquired_at": {
      "format": "date-time",
      "title": "Acquired At",
      "type": "string"
    },
    "coverage_scope": {
      "default": "all_feature_players",
      "enum": [
        "all_feature_players",
        "selected_lineup_players"
      ],
      "title": "Coverage Scope",
      "type": "string"
    },
    "coverage_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActualCoverageSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "data_kind": {
      "enum": [
        "real",
        "fixture",
        "synthetic"
      ],
      "title": "Data Kind",
      "type": "string"
    },
    "limited_mode_acknowledgement": {
      "anyOf": [
        {
          "const": "SELECTED_ONLY_ACTUALS_NOT_GENERALIZABLE",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Limited Mode Acknowledgement"
    },
    "points": {
      "items": {
        "$ref": "#/$defs/ActualPointsRecord"
      },
      "minItems": 1,
      "title": "Points",
      "type": "array"
    },
    "raw_stats_artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Raw Stats Artifact Ids",
      "type": "array"
    },
    "schema_version": {
      "default": "1.3",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_rules_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scoring Rules Artifact Id"
    },
    "scoring_rules_version": {
      "minLength": 1,
      "title": "Scoring Rules Version",
      "type": "string"
    },
    "scoring_source": {
      "minLength": 1,
      "title": "Scoring Source",
      "type": "string"
    },
    "selection_feature_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selection Feature Sha256"
    },
    "selection_seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selection Seed"
    },
    "site": {
      "enum": [
        "dk",
        "fd"
      ],
      "title": "Site",
      "type": "string"
    },
    "slate_id": {
      "minLength": 1,
      "title": "Slate Id",
      "type": "string"
    },
    "source_final": {
      "default": false,
      "title": "Source Final",
      "type": "boolean"
    },
    "source_record_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Record Id"
    },
    "source_timestamp": {
      "format": "date-time",
      "title": "Source Timestamp",
      "type": "string"
    },
    "validation_scope": {
      "default": "FULL_RESEARCH",
      "enum": [
        "FULL_RESEARCH",
        "LIMITED_SINGLE_SLATE_VALIDATION"
      ],
      "title": "Validation Scope",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "data_kind",
    "slate_id",
    "site",
    "scoring_source",
    "scoring_rules_version",
    "acquired_at",
    "source_timestamp",
    "points"
  ],
  "title": "SlateActualPoints",
  "type": "object"
}
