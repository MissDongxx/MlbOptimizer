MLB_CACHE_TTL_SECONDS=180
LINEUP_REFRESH_PREGAME_MINUTES=90
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://diamscore.com,https://www.diamscore.com
USE_MOCK_DATA=true
# Development defaults to true. In production API processes set false and run data_worker.py separately.
RUN_DATA_SCHEDULER=true
CACHE_DIR=cache
ODDS_API_KEY=
ODDS_API_REGIONS=us
ODDS_API_BOOKMAKERS=
DK_SALARY_CSV_URL=
FD_SALARY_CSV_URL=
# Public-page fallback using the same complete JSON loaded by “Show all players”.
DFF_REFRESH_MINUTES=10
ROTOWIRE_VALIDATION_ENABLED=true
ROTOWIRE_REFRESH_MINUTES=10
NWS_USER_AGENT=LineupLab/0.1 contact@example.com
BREVO_API_KEY=
BREVO_SENDER_EMAIL=support@DiamScore.com
BREVO_SENDER_NAME=DiamScore
BREVO_LIST_ID=
BREVO_NOTIFY_EMAIL=
