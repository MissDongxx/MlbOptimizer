{
  "schemaVersion": 2,
  "publishing": {
    "allowAutomaticPublish": true,
    "requiredStatus": "approved",
    "requireNamedReviewer": true,
    "requireReachableSources": true,
    "requireRenderedSeoVerification": true
  },
  "seo": {
    "currentAuditVersion": 2,
    "titleMinCharacters": 35,
    "titleMaxCharacters": 65,
    "descriptionMinCharacters": 120,
    "descriptionMaxCharacters": 165,
    "minimumBodyWords": 800,
    "maximumPrimaryKeywordDensity": 0.03,
    "minimumSections": 4,
    "minimumFaqItems": 3,
    "minimumInternalLinks": 2,
    "openingWordWindow": 100,
    "minimumSupportingKeywords": 3,
    "maximumSupportingKeywords": 5,
    "requirePrimaryKeywordInTitle": true,
    "requirePrimaryKeywordInOpening": true,
    "requirePrimaryKeywordInSectionHeading": true,
    "requirePrimaryKeywordInConclusion": true,
    "requireConclusionSection": true,
    "requireContentDifferentiation": true
  },
  "evidence": {
    "requireClaimSourceMapping": true,
    "requireAccessDate": true,
    "requireLimitationsSection": true,
    "requireUpdatedAt": true,
    "requireClaimLedger": true,
    "requireEditorialAudit": true,
    "sourceRequestTimeoutMs": 15000
  },
  "hardFailures": [
    "missing or fabricated source",
    "unsupported numeric claim",
    "multiple unrelated search intents",
    "prediction presented as fact",
    "duplicate primary keyword",
    "blocked topic",
    "automatic publication after a failed quality gate"
  ]
}
